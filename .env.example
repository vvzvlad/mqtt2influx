# Local environment template for mqtt2influx. Copy it to .env (`make env`) and edit the copy;
# .env itself is gitignored, this file is committed and is the one place the service's whole
# environment surface is written down.
#
# THIS FILE IS READ AUTOMATICALLY, and the order of precedence is worth knowing before a value here
# is trusted. src/settings.py declares every setting in one pydantic-settings class and names
# `.env` in its SettingsConfigDict, so python-dotenv reads this file at startup — but a REAL
# environment variable still wins over it, and an explicit `--port` on the command line wins over
# both. What is written here therefore fills in the blanks; it does not override a deployment.
#
# TZ is the exception: nothing in src/ reads it, it is a setting of the process itself, and it takes
# effect only if the shell exports it (`set -a; . ./.env; set +a`).
#
# The test suite deliberately does NOT read this file: tests/conftest.py switches `env_file` off for
# the whole run, so what is written here can never change what a test says. Otherwise the suite's
# answers would depend on an untracked file that CI does not have.
#
# In production this file does not exist at all — .dockerignore keeps it out of the image and both
# CI workflows exclude it from the tar they ship into the test container. There the same variables
# arrive from two other places: the Dockerfile's ENV lines (BATCH_SIZE and BATCH_INTERVAL only) and
# the `environment:` block of the deployment (DATA_DIR, BATCH_SIZE, BATCH_INTERVAL, TZ).
#
# There are NO credentials here and none belong here. Every MQTT and InfluxDB host, user and
# password this bridge uses lives in {DATA_DIR}/streams.json, written by the web UI — there is no
# environment fallback for any of it. That file is gitignored; this one is public.
#
# Every variable below has a default in src/settings.py, so an empty .env — or no .env at all —
# still starts a working service, and that is a hard rule rather than a happy accident: a required
# setting would make the container exit at import on two production hosts that restart it forever.
# What each one costs when it is wrong is written above it.

# Directory holding streams.json, i.e. EVERY stream this bridge knows about. Read ONCE, at import
# time, by src/config.py, so a change needs a restart rather than a reload. Default: /app/data,
# which is the volume mount point inside the container and is also the directory /entrypoint.sh
# chowns. Locally it has to be overridden — with the default the app tries to create /app/data on
# the workstation and dies on the first save with a permission error, and on a machine where the
# path IS writable it would quietly keep a second copy of the config outside the repo.
DATA_DIR=./data

# TCP port the web UI and the API bind to. Read by main.py only as the DEFAULT for --port, so
# `python main.py --port 9000` still wins over it. Default: 8000. Setting it does not move the
# published port in production: the container keeps 8000 and docker-compose.yml maps it to 8111 on
# the host, so changing this alone would leave that mapping pointing at a port nothing listens on.
PORT=8000

# Write batching for InfluxDB: flush after BATCH_SIZE points or after BATCH_INTERVAL seconds,
# whichever comes first. Both are declared in src/settings.py and read ONCE at import by
# src/mqtt_processor.py — a change needs a restart, not a reload. Defaults 100 / 1.0; production
# runs 220 / 3 from docker-compose.yml.
# Values that are too small multiply the number of write requests InfluxDB receives for the same
# data; too large and the half-built batch that a crash loses is correspondingly bigger, and MQTT
# does not replay it.
BATCH_SIZE=100
BATCH_INTERVAL=1.0

# Timezone of the process. Nothing here formats a local time TODAY — uvicorn's default log format
# carries no timestamp and every time the UI shows is an epoch value the BROWSER renders in its own
# zone — so this is insurance rather than a fix for anything visible: the day one datetime.now()
# reaches a log line, a process with no TZ writes it in UTC while the operator reading it is three
# hours ahead, and that gets discovered mid-incident. Fleet convention; production sets
# Europe/Moscow in docker-compose.yml.
TZ=Europe/Moscow

# Deliberately NOT here: SMOKE_IMAGE and SMOKE_NAME. ci/smoke.py requires both and refuses to start
# without them, but they name one CI run's image and its containers; the workflows in
# .gitea/workflows set them per run, and a stale copy in a developer's .env would have a local gate
# run grading some other image or colliding on a container name. PYTHONUNBUFFERED is absent for a
# different reason — the Dockerfile sets it for the image, and it is an interpreter flag rather than
# a setting of this service.
